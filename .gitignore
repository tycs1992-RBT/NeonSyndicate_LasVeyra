# Unity generated folders (rebuilt automatically when the project opens)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Ee]xportedObj/

# Game builds made with the Neon Syndicate menu or tools/build.ps1 and tools/build.sh
/[Bb]uild/
/[Bb]uilds/

# Asset Store tools, IDE plugins and temporary Addressables output
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# IDE and OS files
.vs/
.vscode/
.idea/
.gradle/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# Crash reports and dumps
sysinfo.txt
crashlytics-build.properties
*.dmp
*.stackdump
mono_crash.*

# Packaged builds
*.apk
*.aab
*.app
*.unitypackage

# 04E build manifest: written by the build step for the in-game STATUS page and removed after each build
/[Aa]ssets/NeonSyndicate/Resources/BuildManifest04E.json
/[Aa]ssets/NeonSyndicate/Resources/BuildManifest04E.json.meta

# Generated Python verification caches
__pycache__/
*.pyc

# H8S Dante living cast review: generated Editor preparation output (prefab and materials), never committed
/[Aa]ssets/NeonSyndicate/Art/ProductionH8S/NPC/Prepared/
/[Aa]ssets/NeonSyndicate/Art/ProductionH8S/NPC/Prepared.meta
/[Aa]ssets/NeonSyndicate/Art/ProductionH9/NPC/Prepared/
/[Aa]ssets/NeonSyndicate/Art/ProductionH9/NPC/Prepared.meta

# Live characters (Editor LiveCastSetup): generated on every machine on the first editor load, never committed
/[Aa]ssets/NeonSyndicate/Resources/LiveCast/
/[Aa]ssets/NeonSyndicate/Resources/LiveCast.meta
/[Aa]ssets/NeonSyndicate/Art/ProductionH9/Prepared/
/[Aa]ssets/NeonSyndicate/Art/ProductionH9/Prepared.meta
/[Aa]ssets/NeonSyndicate/Art/LiveCast/*/Prepared/
/[Aa]ssets/NeonSyndicate/Art/LiveCast/*/Prepared.meta
# Live crowd bodies (LiveCastSetup.Crowd): generated prefabs, merged meshes and materials of the two studies, never committed
/[Aa]ssets/NeonSyndicate/Art/ProductionH8R/NPC/Prepared/
/[Aa]ssets/NeonSyndicate/Art/ProductionH8R/NPC/Prepared.meta

# H8S live world art: the Editor-prepared list (written on project load, before Play and before builds), never committed
/[Aa]ssets/NeonSyndicate/Resources/LiveWorldPrepared/
/[Aa]ssets/NeonSyndicate/Resources/LiveWorldPrepared.meta

# Unity's own copies of the delivered FBX materials: made on each computer the first time the art imports (the live
# characters, the live crowd and the live world art draw with their own generated materials), never committed. Owner
# drop-in folders (Art/LiveCast, Art/LiveWorld) and the tracked CrystalGothicProof materials are not covered.
/[Aa]ssets/NeonSyndicate/Art/Production*/**/Materials/
/[Aa]ssets/NeonSyndicate/Art/Production*/**/Materials.meta
/[Aa]ssets/NeonSyndicate/Art/Candidates*/**/Materials/
/[Aa]ssets/NeonSyndicate/Art/Candidates*/**/Materials.meta
/[Aa]ssets/NeonSyndicate/Art/ImportCalibration04OH/**/Materials/
/[Aa]ssets/NeonSyndicate/Art/ImportCalibration04OH/**/Materials.meta
/[Aa]ssets/NeonSyndicate/Art/WorldFoundationH8R/**/Materials/
/[Aa]ssets/NeonSyndicate/Art/WorldFoundationH8R/**/Materials.meta

# Unity's crash recovery scenes (written to Assets/_Recovery after an editor crash): local backups, never committed
/[Aa]ssets/_[Rr]ecovery/
/[Aa]ssets/_[Rr]ecovery.meta

# L2 native preparation is regenerated before Play and builds.
/[Aa]ssets/NeonSyndicate/Resources/LiveWildsPrepared/
/[Aa]ssets/NeonSyndicate/Resources/LiveWildsPrepared.meta
